# Local development defaults
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# MongoDB Atlas in Preview/Production
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/rb-charity-foundation?retryWrites=true&w=majority

# Admin security
# Use a cryptographically random secret of at least 32 characters.
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-bootstrap-password

# Resend
RESEND_API_KEY=
ADMIN_FROM_EMAIL=RB Charity Foundation <no-reply@your-domain.com>

# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Vercel automatically provides VERCEL and VERCEL_URL.
# Do not manually set PORT on Vercel.
# Set CLIENT_URL to the final HTTPS production domain before going live.
